# copy this to .env and fill in real values
# .env is gitignored — never commit it

ENVIRONMENT=dev
DEBUG=true

# postgres dsn (use docker-compose service name in container, localhost for host)
DATABASE_URL=postgresql+asyncpg://taskflow_user:taskflow_password@localhost:5432/taskflow_db

# redis url
REDIS_URL=redis://localhost:6379/0

# jwt — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# minimum 32 chars enforced by pydantic
JWT_SECRET=change-me-to-something-long-and-random-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# cors — comma-separated, JSON-style list
CORS_ORIGINS=["http://localhost:5173"]
