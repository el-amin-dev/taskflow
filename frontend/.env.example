# Backend API origin. Required.
# Dev: http://localhost:8000
# Prod: set to your deployed backend URL.
VITE_API_URL=

# Cookie lifetimes in seconds. Should match the backend's JWT TTLs:
# JWT_ACCESS_TTL_MINUTES (900 = 15 min), JWT_REFRESH_TTL_DAYS (2592000 = 30 days).
VITE_ACCESS_TTL_SECONDS=900
VITE_REFRESH_TTL_SECONDS=2592000
